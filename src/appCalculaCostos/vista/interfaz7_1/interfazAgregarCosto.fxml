<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="471.0" prefWidth="907.0" style="-fx-background-color: #f5f7fa;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="appCalculaCostos.vista.interfaz7_1.ControladorAgregarCostoMp">

    <VBox alignment="CENTER" prefHeight="522.0" prefWidth="907.0" spacing="20">
        <padding>
            <Insets bottom="20" left="40" right="40" top="20" />
        </padding>

        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Agregar Costos Mano de Obra" />

        <HBox alignment="CENTER" spacing="25">
         <Label fx:id="lblNombre" prefHeight="20.0" prefWidth="784.0" text="nombre_producto" textAlignment="RIGHT">
            <font>
               <Font size="14.0" />
            </font>
            <graphic>
                   <Label text="Producto:">
                  <font>
                     <Font name="System Bold" size="14.0" />
                  </font>
               </Label>
            </graphic>
         </Label>
        </HBox>

        <HBox alignment="CENTER" spacing="20">
            <TableView fx:id="tbEmpleados" prefHeight="300" prefWidth="382.0" HBox.hgrow="NEVER">
                <columns>
                    <TableColumn fx:id="colNombre" prefWidth="157.0" text="Nombre" />
                    <TableColumn fx:id="colApellido" editable="false" prefWidth="177.0" sortable="false" text="Apellido" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

            <VBox alignment="CENTER" spacing="10">
                <Button fx:id="btnAgregar" onAction="#onAgregar" styleClass="boton-accion" text="→">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor></Button>
                <Button fx:id="btnQuitar" onAction="#onQuitar" styleClass="boton-accion" text="←">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor></Button>
            </VBox>

            <TableView fx:id="tbManoObra" prefHeight="300" prefWidth="380">
                <columns>
                    <TableColumn fx:id="colNombreMo" prefWidth="127.0" text="Nombre" />
                    <TableColumn fx:id="colApellidoMo" prefWidth="122.0" text="Apellido" />
               <TableColumn fx:id="colTiempoMo" prefWidth="129.0" text="Tiempo Aportado" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </HBox>
   
        <HBox alignment="BOTTOM_CENTER" spacing="15">
            <Button fx:id="btnGuardar" onAction="#onGuardar" styleClass="boton-primario" text="Guardar">
            <cursor>
               <Cursor fx:constant="HAND" />
            </cursor>
         </Button>
        </HBox>

    </VBox>
</AnchorPane>
