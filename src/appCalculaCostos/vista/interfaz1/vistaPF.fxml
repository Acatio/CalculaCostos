<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="appCalculaCostos.vista.interfaz1.ControladorPf">
   <center>
      <AnchorPane prefHeight="480" prefWidth="750" style="-fx-background-color: #f0f3f7;">
          <VBox alignment="TOP_LEFT" layoutX="14.0" layoutY="25.0" spacing="20" AnchorPane.bottomAnchor="25.0" AnchorPane.leftAnchor="14.0" AnchorPane.rightAnchor="36.0" AnchorPane.topAnchor="25.0">
              <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 8, 0, 0, 4); -fx-padding: 0;" VBox.vgrow="ALWAYS">
                  <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 15 20 10 20;">
                      <TextField fx:id="txtBuscar" prefHeight="35.0" prefWidth="230.0" promptText="Buscar" style="-fx-background-radius: 5; -fx-padding: 8 12 8 12; -fx-border-color: #ccc; -fx-border-radius: 5; -fx-background-color: #f7f7f7;" HBox.hgrow="ALWAYS" />
                      <Label style="-fx-font-size: 16px; -fx-text-fill: #666;" text="🔍" />
                  </HBox>
      
                  <TableView fx:id="tablaProductos" VBox.vgrow="ALWAYS">
                      <VBox.margin>
                          <Insets bottom="20" left="20" right="20" top="0" />
                      </VBox.margin>
      
                      <columns>
                          <TableColumn fx:id="colNombre" editable="false" minWidth="120" prefWidth="153.0" sortable="false" text="Nombre" />
                          <!-- Esta columna se le asignará el texto en el controlador -->
                          <TableColumn fx:id="colPorcentajeGanancia" editable="false" minWidth="105.0" prefWidth="163.0" sortable="false" text="\% Ganancia" />
                          <TableColumn fx:id="colPrecioVenta" editable="false" minWidth="46.0" prefWidth="134.0" sortable="false" text="Precio venta" />
                     <TableColumn fx:id="colVentasMensuales" editable="false" minWidth="46.0" prefWidth="127.0" sortable="false" text="Ventas Mensuales" />
                          <TableColumn fx:id="colCosto" editable="false" minWidth="72.0" prefWidth="83.0" sortable="false" text="Costo Total" />
                      </columns>
                  <columnResizePolicy>
                     <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                  </columnResizePolicy>
                  </TableView>
              </VBox>
          </VBox>
      </AnchorPane>
   </center>
   <top>
      <MenuBar BorderPane.alignment="CENTER">
        <menus>
          <Menu mnemonicParsing="false" text="Productos">
            <items>
              <MenuItem fx:id="itmNuevo" mnemonicParsing="false" onAction="#onActionNuevo" text="Nuevo " />
                  <MenuItem fx:id="itmEditar" mnemonicParsing="false" onAction="#onActionEditar" text="Editar" />
                  <MenuItem mnemonicParsing="false" onAction="#onActionEliminar" text="Eliminar" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Asignar Costo">
            <items>
                  <Menu mnemonicParsing="false" text="Costos Fijos">
                     <items>
                        <MenuItem mnemonicParsing="false" onAction="#onAgregarCf" text="Ponderaciones" />
                        <MenuItem mnemonicParsing="false" onAction="#onCalcularCostosFijos" text="Calcular Costos Fijos" />
                     </items>
                  </Menu>
              <MenuItem mnemonicParsing="false" onAction="#onAgregarCmp" text="Materia Prima" />
                  <MenuItem mnemonicParsing="false" text="Mano Obra" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Inventario">
            <items>
              <MenuItem fx:id="itmInsumos" mnemonicParsing="false" onAction="#onActionInsumos" text="Insumos" />
                  <MenuItem mnemonicParsing="false" onAction="#onInventarioCostosFijos" text="Costos Fijos" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
   </top>
</BorderPane>
