<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="550" prefWidth="800" style="-fx-background-color: #f5f7fa;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/24.0.1" fx:controller="interfaz3.Controlador">
    
    <BorderPane fx:id="mainContainer" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <!-- ================= ENCABEZADO ================= -->
        <top>
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #34495e; -fx-padding: 15;">
                <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;" text="Opciones" />
            </HBox>
        </top>

        <!-- ================= CONTENIDO CENTRAL ================= -->
        <center>
            <VBox spacing="15">
                <padding>
                    <Insets bottom="20" left="20" right="20" top="20" />
                </padding>
                
                <!-- Barra de búsqueda -->
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <TextField fx:id="txtBuscar" promptText="Buscar..." styleClass="campo-busqueda" HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnBuscar" styleClass="boton-busqueda" text="🔍" />
                </HBox>

                <!-- Tablas divididas -->
                <SplitPane dividerPositions="0.5" VBox.vgrow="ALWAYS">
                    
                    <!-- Tabla de insumos -->
                    <AnchorPane>
                        <TableView fx:id="tablaInsumos" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
                            <columns>
                                <TableColumn fx:id="colNombre" prefWidth="150" text="Nombre" />
                                <TableColumn fx:id="colTipo" prefWidth="120" text="Tipo" />
                                <TableColumn fx:id="colUnidad" prefWidth="100" text="Unidad Medida" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </AnchorPane>

                    <!-- Tabla de ingredientes -->
                    <AnchorPane>
                        <TableView fx:id="tablaIngredientes" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
                            <columns>
                                <TableColumn fx:id="colNombreIng" prefWidth="150" text="Ingrediente" />
                                <TableColumn fx:id="colCantidadIng" prefWidth="100" text="Cantidad" />
                                <TableColumn fx:id="colCostoIng" prefWidth="100" text="Costo" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </AnchorPane>
                </SplitPane>
            </VBox>
        </center>

        <!-- ================= PIE DE PÁGINA ================= -->
        <bottom>
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <padding>
                    <Insets bottom="15" left="25" right="25" top="15" />
                </padding>
                <Button fx:id="btnAgregarIngrediente" styleClass="boton-accion" text="Agregar ingrediente" />
                <Button fx:id="btnFinalizar" styleClass="boton-primario" text="Finalizar" />
            </HBox>
        </bottom>

    </BorderPane>
</AnchorPane>
