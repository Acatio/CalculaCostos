<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600" prefWidth="900" style="-fx-background-color: #f5f7fa;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="appCalculaCostos.vista.interfaz7.ControladorAgregarCostoMp">

    <VBox alignment="CENTER" prefHeight="609.0" prefWidth="907.0" spacing="20">
        <padding>
            <Insets bottom="20" left="40" right="40" top="20" />
        </padding>

        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Agregar Costos Materia Prima" />

        <HBox alignment="CENTER" spacing="25">
             <Label text="Producto:">
            <font>
               <Font name="System Bold" size="14.0" />
            </font>
         </Label>
            <VBox alignment="CENTER_LEFT" spacing="5">
            <children>
               <Label fx:id="lblNombre" text="nombre_producto">
                  <font>
                     <Font size="14.0" />
                  </font></Label>
            </children>
            </VBox>

            <VBox alignment="CENTER_LEFT" spacing="5" />

            <VBox alignment="CENTER_LEFT" spacing="5" />
        </HBox>

        <HBox alignment="CENTER" spacing="20">
            <TableView fx:id="tbInsumos" prefHeight="300" prefWidth="380" HBox.hgrow="NEVER">
                <columns>
                    <TableColumn fx:id="colInsumo" prefWidth="198.0" text="Insumo" />
                    <TableColumn fx:id="colUnidad" editable="false" prefWidth="180.0" sortable="false" text="Unidad" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

            <VBox alignment="CENTER" spacing="10">
                <Button fx:id="btnAgregar" onAction="#onAgregar" styleClass="boton-accion" text="→">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor></Button>
                <Button fx:id="btnQuitar" onAction="#onQuitar" styleClass="boton-accion" text="←">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor></Button>
            </VBox>

            <TableView fx:id="tbIngredientes" prefHeight="300" prefWidth="380">
                <columns>
                    <TableColumn fx:id="colIngrediente" prefWidth="180" text="Ingrediente" />
                    <TableColumn fx:id="colCantidad" prefWidth="100" text="Cantidad" />
               <TableColumn fx:id="colUnidadIngrediente" prefWidth="100" text="Unidad" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </HBox>
   
        <HBox alignment="BOTTOM_CENTER" spacing="15">
            <Button fx:id="btnGuardar" onAction="#onGuardar" styleClass="boton-primario" text="Guardar">
            <cursor>
               <Cursor fx:constant="HAND" />
            </cursor>
         </Button>
            <Button fx:id="btnCancelar" onAction="#onCancelar" styleClass="boton-secundario" text="Cancelar">
            <cursor>
               <Cursor fx:constant="HAND" />
            </cursor>
         </Button>
        </HBox>

    </VBox>
</AnchorPane>
