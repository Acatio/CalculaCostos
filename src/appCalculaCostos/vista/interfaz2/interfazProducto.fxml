<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="362.0" prefWidth="368.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="appCalculaCostos.vista.interfaz2.InterfazProductoController">
   <center>
          <VBox alignment="TOP_CENTER" prefHeight="359.0" prefWidth="550.0" spacing="20" style="-fx-padding: 30;" BorderPane.alignment="CENTER">
              
                          <GridPane hgap="10" prefHeight="182.0" prefWidth="402.0" vgap="15">
                  <columnConstraints>
                      <ColumnConstraints hgrow="NEVER" minWidth="150" prefWidth="150" />
                      <ColumnConstraints hgrow="ALWAYS" minWidth="200" />
                  </columnConstraints>
                  
                              <Label style="-fx-font-weight: bold;" text="Nombre" textFill="#574747" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                  <TextField fx:id="txtNombre" prefHeight="25.0" prefWidth="89.0" style="-fx-background-radius: 4;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Label style="-fx-font-weight: bold;" text="Porcentaje de ganancia" textFill="#574747" GridPane.rowIndex="1" />
                  <TextField fx:id="txtPorcentajeGanancia" disable="true" editable="false" focusTraversable="false" promptText="0.0" style="-fx-background-radius: 4;" text="0.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label layoutX="10.0" layoutY="54.0" style="-fx-font-weight: bold;" text="Precio de Venta" textFill="#574747" GridPane.rowIndex="2" />
            <TextField fx:id="txtPrecioVenta" layoutX="170.0" layoutY="50.0" prefHeight="25.0" prefWidth="148.0" style="-fx-background-radius: 4;" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Label layoutX="10.0" layoutY="97.0" style="-fx-font-weight: bold;" text="Ventas Mensuales" textFill="#574747" GridPane.rowIndex="3" />
            <TextField fx:id="txtCantidadVendida" layoutX="170.0" layoutY="93.0" style="-fx-background-radius: 4;" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
               <RowConstraints minHeight="10.0" prefHeight="30.0" />
               <RowConstraints minHeight="10.0" prefHeight="30.0" />
            </rowConstraints>
              </GridPane>
              
                          <Region VBox.vgrow="ALWAYS" /> 

                    <Button fx:id="btnSiguiente" onAction="#onActionAceptar" style="-fx-font-size: 14px; -fx-background-color: #4a86e8; -fx-text-fill: white; -fx-padding: 8 25; -fx-background-radius: 5;" text="Aceptar">
            <cursor>
               <Cursor fx:constant="HAND" />
            </cursor></Button>
          </VBox>
   </center>
</BorderPane>
