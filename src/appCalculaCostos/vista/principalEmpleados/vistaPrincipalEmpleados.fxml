<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="appCalculaCostos.vista.principalEmpleados.ControladorPrincipalEmpleados">
   <top>
      <MenuBar BorderPane.alignment="CENTER">
        <menus>
          <Menu mnemonicParsing="false" text="Emplados">
            <items>
              <MenuItem fx:id="itmNuevo" mnemonicParsing="false" onAction="#onNuevoEmpleado" text="Nuevo " />
                  <MenuItem fx:id="itmEditar" mnemonicParsing="false" onAction="#onEditarEmpleado" text="Editar" />
                  <MenuItem mnemonicParsing="false" onAction="#onEliminarEmpleado" text="Eliminar" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
   </top>
   <center>
      <AnchorPane prefHeight="480" prefWidth="750" style="-fx-background-color: #f0f3f7;" BorderPane.alignment="CENTER">
          <VBox alignment="TOP_LEFT" layoutX="14.0" layoutY="25.0" spacing="20" AnchorPane.bottomAnchor="25.0" AnchorPane.leftAnchor="14.0" AnchorPane.rightAnchor="36.0" AnchorPane.topAnchor="25.0">
              <VBox alignment="CENTER" spacing="10" style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 8, 0, 0, 4); -fx-padding: 0;" VBox.vgrow="ALWAYS">
                  <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 15 20 10 20;">
                      <TextField fx:id="txtBuscar" prefHeight="35.0" prefWidth="230.0" promptText="Buscar" style="-fx-background-radius: 5; -fx-padding: 8 12 8 12; -fx-border-color: #ccc; -fx-border-radius: 5; -fx-background-color: #f7f7f7;" HBox.hgrow="ALWAYS" />
                      <Label style="-fx-font-size: 16px; -fx-text-fill: #666;" text="🔍" />
                  </HBox>
      
                  <TableView fx:id="tablaEmpleados" VBox.vgrow="ALWAYS">
                      <VBox.margin>
                          <Insets bottom="20" left="20" right="20" top="0" />
                      </VBox.margin>
      
                      <columns>
                          <!-- Esta columna se le asignará el texto en el controlador -->
                          <TableColumn fx:id="colNombre" editable="false" minWidth="105.0" prefWidth="159.0" sortable="false" text="Nombre" />
                          <TableColumn fx:id="colApellido" editable="false" minWidth="120" prefWidth="176.0" sortable="false" text="Apellido" />
                     <TableColumn fx:id="colSalario" editable="false" minWidth="120" prefWidth="155.0" sortable="false" text="Salario Mensual" />
                     <TableColumn fx:id="colHoras" editable="false" minWidth="120" prefWidth="171.0" sortable="false" text="horas/semana" />
                      </columns>
                  <columnResizePolicy>
                     <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                  </columnResizePolicy>
                  </TableView>
              </VBox>
          </VBox>
      </AnchorPane>
   </center>
</BorderPane>
