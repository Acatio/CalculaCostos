<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<TabPane xmlns:fx="http://javafx.com/fxml/1" 
         prefWidth="600" prefHeight="400" 
         tabClosingPolicy="UNAVAILABLE"
         style="-fx-background-color: #f0f3f7;">
    
    <tabs>
        <Tab text="Producto">
            <content>
                <VBox spacing="20" alignment="TOP_CENTER" style="-fx-padding: 30;">
                    
                    <GridPane hgap="10" vgap="15">
                        <columnConstraints>
                            <ColumnConstraints hgrow="NEVER" minWidth="150" prefWidth="150"/>
                            <ColumnConstraints hgrow="ALWAYS" minWidth="200"/>
                        </columnConstraints>
                        
                        <Label text="Nombre" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-background-radius: 4;"/>

                        <Label text="Porcentaje de ganancia" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="txtPorcentajeGanancia" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-background-radius: 4;"/>
                    </GridPane>
                    
                    <Region VBox.vgrow="ALWAYS" /> 

                    <Button text="Siguiente" fx:id="btnSiguiente" 
                            style="-fx-font-size: 14px; -fx-background-color: #4a86e8; -fx-text-fill: white; -fx-padding: 8 25; -fx-background-radius: 5;"/>
                </VBox>
            </content>
        </Tab>

        <Tab text="Costo Materia Prima">
            <content>
                <AnchorPane/>
            </content>
        </Tab>
        
        <Tab text="Costo Mano Obra">
            <content>
                <AnchorPane/>
            </content>
        </Tab>
    </tabs>
</TabPane>
