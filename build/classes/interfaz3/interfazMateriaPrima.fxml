<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="interfaz3.Controlador"
            prefWidth="800" prefHeight="550"
            style="-fx-background-color: #f5f7fa;">
    
    <BorderPane fx:id="mainContainer"
                AnchorPane.topAnchor="0"
                AnchorPane.rightAnchor="0"
                AnchorPane.bottomAnchor="0"
                AnchorPane.leftAnchor="0">

        <!-- ================= ENCABEZADO ================= -->
        <top>
            <HBox alignment="CENTER_LEFT" spacing="10"
                  style="-fx-background-color: #34495e; -fx-padding: 15;">
                <Label text="Opciones"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </HBox>
        </top>

        <!-- ================= CONTENIDO CENTRAL ================= -->
        <center>
            <VBox spacing="15">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>
                
                <!-- Barra de búsqueda -->
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <TextField fx:id="txtBuscar"
                               promptText="Buscar..."
                               styleClass="campo-busqueda"
                               HBox.hgrow="ALWAYS"/>
                    <Button text="🔍" fx:id="btnBuscar" styleClass="boton-busqueda"/>
                </HBox>

                <!-- Tablas divididas -->
                <SplitPane dividerPositions="0.5" VBox.vgrow="ALWAYS">
                    
                    <!-- Tabla de insumos -->
                    <AnchorPane>
                        <TableView fx:id="tablaInsumos"
                                   AnchorPane.topAnchor="0"
                                   AnchorPane.rightAnchor="0"
                                   AnchorPane.bottomAnchor="0"
                                   AnchorPane.leftAnchor="0">
                            <columns>
                                <TableColumn fx:id="colId" text="Id" prefWidth="50"/>
                                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="150"/>
                                <TableColumn fx:id="colTipo" text="Tipo" prefWidth="120"/>
                                <TableColumn fx:id="colUnidad" text="Unidad Medida" prefWidth="100"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                        </TableView>
                    </AnchorPane>

                    <!-- Tabla de ingredientes -->
                    <AnchorPane>
                        <TableView fx:id="tablaIngredientes"
                                   AnchorPane.topAnchor="0"
                                   AnchorPane.rightAnchor="0"
                                   AnchorPane.bottomAnchor="0"
                                   AnchorPane.leftAnchor="0">
                            <columns>
                                <TableColumn fx:id="colIdIng" text="Id" prefWidth="50"/>
                                <TableColumn fx:id="colNombreIng" text="Ingrediente" prefWidth="150"/>
                                <TableColumn fx:id="colCantidadIng" text="Cantidad" prefWidth="100"/>
                                <TableColumn fx:id="colCostoIng" text="Costo" prefWidth="100"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                        </TableView>
                    </AnchorPane>
                </SplitPane>
            </VBox>
        </center>

        <!-- ================= PIE DE PÁGINA ================= -->
        <bottom>
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <padding>
                    <Insets top="15" right="25" bottom="15" left="25"/>
                </padding>
                <Button text="Agregar ingrediente"
                        fx:id="btnAgregarIngrediente"
                        styleClass="boton-accion"/>
                <Button text="Finalizar"
                        fx:id="btnFinalizar"
                        styleClass="boton-primario"/>
            </HBox>
        </bottom>

    </BorderPane>
</AnchorPane>
