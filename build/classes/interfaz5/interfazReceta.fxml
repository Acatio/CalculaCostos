<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="interfaz5.ControladorReceta"
            prefWidth="900" prefHeight="600"
            style="-fx-background-color: #f5f7fa;">

    <VBox spacing="20" alignment="CENTER">
        <padding>
            <Insets top="20" right="40" bottom="20" left="40"/>
        </padding>

        <Label text="Registrar Receta"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

        <HBox spacing="25" alignment="CENTER">
            <VBox spacing="5" alignment="CENTER_LEFT">
                <Label text="Nombre:"/>
                <TextField fx:id="txtNombre" promptText="Ej. Enchiladas" styleClass="campo-texto"/>
            </VBox>

            <VBox spacing="5" alignment="CENTER_LEFT">
                <Label text="Cantidad producida:"/>
                <TextField fx:id="txtCantidad" promptText="Ej. 10" styleClass="campo-texto"/>
            </VBox>

            <VBox spacing="5" alignment="CENTER_LEFT">
                <Label text="Unidad de medida:"/>
                <ComboBox fx:id="cmbUnidad" promptText="Selecciona unidad" styleClass="campo-combo"/>
            </VBox>
        </HBox>

        <HBox spacing="20" alignment="CENTER">
            <TableView fx:id="tablaInsumosDisponibles" prefWidth="380" prefHeight="300">
                <columns>
                    <TableColumn fx:id="colNombreInsumo" text="Nombre" prefWidth="180"/>
                    <TableColumn fx:id="colUnidadInsumo" text="Unidad" prefWidth="100"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <VBox spacing="10" alignment="CENTER">
                <Button text="→" fx:id="btnAgregar" styleClass="boton-accion"/>
                <Button text="←" fx:id="btnQuitar" styleClass="boton-accion"/>
            </VBox>

            <TableView fx:id="tablaInsumosSeleccionados" prefWidth="380" prefHeight="300">
                <columns>
                    <TableColumn fx:id="colNombreSel" text="Insumo" prefWidth="180"/>
                    <TableColumn fx:id="colCantidadSel" text="Cantidad" prefWidth="100"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </HBox>

        <HBox spacing="15" alignment="CENTER">
            <Button text="Guardar Receta" fx:id="btnGuardar" styleClass="boton-primario"/>
            <Button text="Cancelar" fx:id="btnCancelar" styleClass="boton-secundario"/>
        </HBox>

    </VBox>
</AnchorPane>
